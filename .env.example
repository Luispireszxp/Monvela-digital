# WhatsApp com DDI e DDD, somente números. Exemplo de formato: 5585999999999
NEXT_PUBLIC_WHATSAPP_NUMBER=

# E-mail público exibido no rodapé
NEXT_PUBLIC_CONTACT_EMAIL=

# URL final do site, sem barra no fim. Durante o desenvolvimento:
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: use apenas a URL e a chave pública (publishable) no navegador
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
