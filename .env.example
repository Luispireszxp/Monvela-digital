# WhatsApp com DDI e DDD, somente números. Ex.: 5585999999999
# Enquanto vazio, os botões abrem o WhatsApp com a mensagem pronta, sem destinatário.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# E-mail público exibido no rodapé. Só aparece quando preenchido.
NEXT_PUBLIC_CONTACT_EMAIL=

# Perfil ou página da Monvela no Facebook (URL completa https://).
# O link no cabeçalho, rodapé e seção "Sobre" só aparece quando preenchido.
NEXT_PUBLIC_FACEBOOK_URL=

# Instagram — apenas preparado para o futuro. Não é exibido no site ainda.
NEXT_PUBLIC_INSTAGRAM_URL=

# URL final do site, sem barra no fim. Durante o desenvolvimento:
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: use apenas a URL e a chave pública (publishable) no navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Medição — deixe vazio. Nenhum script de rastreamento é carregado sem ID real,
# e só depois de revisar a política de privacidade e o consentimento.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
